# Never commit model weights, databases or credentials
*.safetensors
*.bin
*.gguf
*.pt
*.pth
*.ckpt
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.zip
*.tgz
*.tar.gz

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.venv-*/
venv/
env/

# Run outputs (regenerated, not evidence -- evidence lives in results/).
# Anchored to the repository root on purpose: results/logs/ holds the real job
# logs and must stay tracked.
/out/
/build/
/dist/
*.egg-info/

# Decompressed benchmarks: the tracked form is .jsonl.gz
data/longctx_max.jsonl
data/public_lb.jsonl
data/public_lb_typeb.jsonl
data/public_lb_typec.jsonl

# Credentials
*.pem
*.key
*credentials*
.netrc
_netrc
.env
.env.*
