# Byte-level hygiene: everything textual is stored with LF so that generated
# files compare byte-identically on any platform (see src/analysis_quad4/
# make_e2e_quad.py, which regenerates src/longctx/e2e_quad.py and must produce
# exactly the committed bytes).
* text=auto eol=lf

# Binaries are never converted
*.gz    binary
*.pdf   binary
*.png   binary
*.jpg   binary
*.zip   binary
*.pt    binary
*.bin   binary
*.safetensors binary
